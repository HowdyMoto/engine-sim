{
  "name": "engine-sim-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Real-time internal combustion engine simulator - TypeScript/WebAudio port of ange-yaghi/engine-sim",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "benchmark": "esbuild tools/benchmark.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/benchmark.mjs --log-level=error && node node_modules/.cache/benchmark.mjs",
    "diagnose": "esbuild tools/diagnose.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/diagnose.mjs --log-level=error && node node_modules/.cache/diagnose.mjs",
    "smoke": "node tools/smoke.mjs",
    "build:wasm": "node tools/build-wasm.mjs"
  },
  "devDependencies": {
    "assemblyscript": "^0.28.20",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.10.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
